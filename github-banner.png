:100.00:6\"}],\"version\":48,\"id_type\":\"userID\",\"value\":{\"health_v3_tabs\":{\"records\":{\"ecosystem_view_slug\":\"recordsTimeline\",\"visible\":true},\"tab_order\":[\"home\",\"chats\",\"records\",\"accounts\"],\"home\":{\"ecosystem_view_slug\":\"home\",\"visible\":true},\"chats\":{\"visible\":true},\"accounts\":{\"visible\":true,\"ecosystem_view_slug\":\"connections\"}},\"health_v3_starter_prompts_enabled\":true,\"enabled\":true},\"is_device_based\":false,\"passed\":true},\"1557207450\":{\"name\":\"1557207450\",\"rule_id\":\"32VLeM6QnhA95ArjBrqcGC\",\"secondary_exposures\":[{\"gate\":\"1192462084\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1506791903\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":9,\"id_type\":\"userID\",\"value\":{\"enabled\":false},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"enabled\"],\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"1571275116\":{\"name\":\"1571275116\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"migration_cutoff\":\"2026-10-29T18:00:00Z\",\"enabled\":true},\"is_device_based\":false,\"passed\":false},\"1571655448\":{\"name\":\"1571655448\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":203,\"id_type\":\"stableID\",\"value\":{\"rpc_timeout_ms\":5000,\"balance_owner_account_limit\":500,\"workspace_broadcast_member_threshold\":500,\"push_snapshot_interval_seconds\":5,\"client_stream_rotation_ms\":1680000,\"client_stream_initial_timeout_ms\":45000,\"push_pending_capacity\":4096,\"presence_renewal_seconds\":1800,\"polling_seconds_if_stream_enabled\":3600,\"presence_cache_write_timeout_ms\":3000,\"push_only_when_healthy\":true,\"presence_cache_read_timeout_ms\":2000,\"client_stream_stable_ms\":30000,\"publisher_workers\":32,\"enabled\":false,\"publish_timeout_ms\":5000,\"presence_replication_timeout_ms\":3000,\"presence_ttl_seconds\":3600,\"heartbeat_